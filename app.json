{
  "expo": {
    "name": "Meu Plano",
    "slug": "app-saude",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1F1EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meuplano.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F1F1EF",
        "dark": {
          "image": "./assets/splash-icon-dark.png",
          "backgroundColor": "#222221"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#222221"
      },
      "package": "com.meuplano.app",
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F1F1EF",
        "dark": {
          "image": "./assets/splash-icon-dark.png",
          "backgroundColor": "#222221"
        }
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "meuplano.app",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Meu Plano",
      "shortName": "Meu Plano",
      "themeColor": "#222221",
      "backgroundColor": "#222221"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "meuplano",
    "extra": {
      "supabaseUrl": "https://SEU_PROJECT_REF.supabase.co",
      "supabaseAnonKey": "SUPABASE_ANON_KEY_PLACEHOLDER",
      "googleWebClientId": "000000000000-44gakb07dp4rufakqjm4nbanq7cgnfhe.apps.googleusercontent.com",
      "googleAndroidClientId": "000000000000-o3n4o1qo9cmf2srjkhe48su4if6v3f95.apps.googleusercontent.com",
      "eas": {
        "projectId": "0632e100-7c40-4a5d-ae24-245c1d5a89d1"
      }
    },
    "owner": "luiz2904s-team"
  }
}
